# Kaizeval configuration. Copy to .env and adjust. Every value has a safe default.
# Never commit a real .env file.

# --- Network boundary -------------------------------------------------------------------
# true  = strict offline: only loopback, private and allowlisted endpoints can be reached.
#         No workspace can override this. This is the default.
# false = workspaces may be switched to "connected" and use owner-approved public providers.
KAIZEVAL_OFFLINE=true
# Internal host names (comma separated) that contain dots but are inside your network.
KAIZEVAL_EGRESS_ALLOWLIST=

# --- Storage ----------------------------------------------------------------------------
# Where the SQLite database, uploaded files and the generated secret key live (single-node mode).
# KAIZEVAL_DATA_DIR=/var/lib/kaizeval
# Use PostgreSQL instead of SQLite (install the extra: pip install "kaizeval[postgres]").
# KAIZEVAL_DATABASE_URL=postgresql+psycopg://kaizeval:CHANGE_ME@localhost:5432/kaizeval
# filesystem (default) or s3 (any S3-compatible service; pip install "kaizeval[s3]")
KAIZEVAL_STORAGE_BACKEND=filesystem
# KAIZEVAL_S3_ENDPOINT_URL=http://minio:9000
# KAIZEVAL_S3_BUCKET=kaizeval
# KAIZEVAL_S3_ACCESS_KEY=
# KAIZEVAL_S3_SECRET_KEY=

# --- Security ---------------------------------------------------------------------------
# Signs access tokens and encrypts stored credentials. If unset, a key is generated once and
# saved in the data directory. Set it explicitly when several containers share one database.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KAIZEVAL_SECRET_KEY=
# After the first account exists, set to false to stop open self-registration.
KAIZEVAL_ALLOW_SIGNUP=true
KAIZEVAL_TOKEN_TTL_MINUTES=720
# Only needed when the console is served from a different origin than the API.
KAIZEVAL_CORS_ORIGINS=

# --- Workers ----------------------------------------------------------------------------
# inline   = jobs run on a thread inside the API process (default, single node)
# external = run one or more `kaizeval worker` processes
KAIZEVAL_WORKER_MODE=inline

KAIZEVAL_LOG_LEVEL=INFO
KAIZEVAL_MAX_UPLOAD_MB=25

# --- Docker Compose only ----------------------------------------------------------------
POSTGRES_PASSWORD=
SAMPLE_AGENT_ADMIN_TOKEN=
